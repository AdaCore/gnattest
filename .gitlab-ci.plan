cov_qualifier={"instr-cov": True}

def build_(qualifier=cov_qualifier):
    with defaults(qualifier=qualifier):
        anod_build("gnattest")

def test_(qualifier=cov_qualifier):
    with defaults(qualifier=qualifier):
        # Install the component built in the preceding CI build job
        anod_install("gnattest")
        anod_test("gnattest")

def test_gnatfuzz_tests(qualifier=cov_qualifier):
    with defaults(qualifier=qualifier):
        # Install the component already built in previous stage
        anod_install("gnattest")
        anod_test("gnattest", qualifier={"gnatfuzz-tests": True, **cov_qualifier})

# Edge

edge_qualifier = {"edge": True, **cov_qualifier}

def build_edge():
    build_(edge_qualifier)

def test_edge():
    test_(edge_qualifier)

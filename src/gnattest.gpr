with "../config.gpr";
with "gpr2.gpr";
with "libadalang.gpr";
with "templates_parser.gpr";

library project GNATtest is

   type Target_Type is ("Windows_NT", "unix", "osx");
   Target : Target_Type := external ("OS", "unix");

   type Library_Type_Type is ("static", "static-pic", "relocatable");
   Library_Type : Library_Type_Type := external ("LIBRARY_TYPE", "static");

   Build_Mode : Config.Build_Mode_Type := external ("BUILD_MODE", "dev");

   for Source_Dirs use
     (".", "tgen", "tgen/tgen_rts",
      "../share/tgen/templates",
      "../share/tgen/templates/marshalling_templates",
      "../share/tgen/templates/json_templates",
      "../share/tgen/templates/type_representation_templates");

   for Object_Dir use "../obj/" & Library_Type;
   for Library_Kind use Library_Type;
   for Library_Dir use "../lib/" & Library_Type;
   for Library_Name use "gnattest";

   for Languages use ("Ada", "Templates");

   package Compiler renames Config.Compiler;

   package Linker is
      case Build_Mode is
         when "AddressSanitizer" =>
            for Switches ("Ada") use ("-fsanitize=address");
         when others =>
            null;
      end case;
   end Linker;

   package Naming is
      for Implementation_Suffix ("Templates") use ".tmplt";
   end Naming;

   for Excluded_Source_Files use ("test-main.adb");

end GNATtest;

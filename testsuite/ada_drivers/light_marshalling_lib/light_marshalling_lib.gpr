with "../../../config.gpr";
with "gnattest.gpr";
with "gnatcoll";
with "gpr2";
with "libadalang";

project Light_Marshalling_Lib is
   for Object_Dir use "obj";
   for Exec_Dir use "../../../bin/";
   for Main use ("light_marshalling_lib.adb");

   package Compiler renames Config.Compiler;
end Light_Marshalling_Lib;

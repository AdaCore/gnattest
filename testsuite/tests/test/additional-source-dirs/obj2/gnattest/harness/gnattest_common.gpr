abstract project Gnattest_Common is
   for Languages use ("Ada");
   for Source_Files use ();

   --  Directories listed here are added to the Source_Dirs of every
   --  test driver, so common hand-written test code can be shared
   --  across harnesses. Anchor each entry to this project's
   --  directory so that it resolves identically from every driver,
   --  regardless of where the driver is located, e.g.:
   --     Additional_Source_Dirs :=
   --       (Gnattest_Common'Project_Dir & "../common-tests");
   Additional_Source_Dirs := (Gnattest_Common'Project_Dir & "../../../shared");
   for Target use "x86_64-linux";

   type TD_Compilation_Type is ("contract-checks","no-contract-checks", "no-config-file");
   TD_Compilation : TD_Compilation_Type := external ("TEST_DRIVER_BUILD_MODE", "no-config-file");

   package Builder is
      case TD_Compilation is
         when "contract-checks" =>
            for Global_Configuration_Pragmas use "suppress.adc";
         when "no-contract-checks" =>
            for Global_Configuration_Pragmas use "suppress_no_ghost.adc";
         when "no-config-file" =>
            null;
      end case;
   end Builder;

   package Linker is
      for Default_Switches ("ada") use ("-g");
   end Linker;

   package Binder is
      for Default_Switches ("ada") use ("-E", "-static");
   end Binder;

   Contract_Switches := ();
   case TD_Compilation is
      when "contract-checks" =>
         Contract_Switches := ("-gnata");
      when others =>
         null;
   end case;
   package Compiler is
      for Default_Switches ("ada") use
        ("-g", "-gnatyM0") & Contract_Switches;
   end Compiler;

end Gnattest_Common;

project Prj is

   for Object_Dir use "obj";
   for Source_Dirs use ("src");

   package Builder is
      for Switches ("ada") use ("-k");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-O1", "-gnatwa");
      for Local_Configuration_Pragmas use "prj.adc";
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-t");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-Wl,--no-as-needed");
   end Linker;

end Prj;

library project Gnattest_Unity is
   type Hosted_Type is ("false", "true");
   Hosted : Hosted_Type := external ("GNATTEST_UNITY_HOSTED", "false");
   Hosted_Switches := ();

   --  Compiler macros can claim a hosted system on bareboard targets.
   case Hosted is
      when "true" =>
         Hosted_Switches := ("-DGNATTEST_HOSTED");
      when "false" =>
         null;
   end case;

   for Languages use ("C");
   for Source_Dirs use ("../unity/src", ".");
   for Object_Dir use "obj";
   for Library_Name use "gnattest_unity";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("C") use
        ("-g", "-DUNITY_INCLUDE_CONFIG_H") & Hosted_Switches;
   end Compiler;

end Gnattest_Unity;

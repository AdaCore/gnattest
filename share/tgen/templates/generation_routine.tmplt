@@--  Template to generate a generation routine for a given
@@--  subprogram.
@@--  @_GLOBAL_PREFIX_@ Prefix used to prefix all local entities to the unit.
@@--  @_SUBP_NAME_@ Simple name of the subprogram for which test vectors will
@@--                be generated.
@@--  @_SUBP_FQN_@ Fully qualified name of the subprogram, without the standard
@@--               prefix nor the eventual generic wrapper
@@--  @_SUBP_UID_@ UID of the subprogram
@@--  @_FN_TYP_REF_@ Name of the Typ_Access representing this subp in the value
@@--                 library.
@@--  @_SUBP_RETURN_TY_@ FQN of the return type of the subprogram. Should be
@@--                     empty if we are dealing with a procedure.
@@--  @_PARAM_NAME_@ Simple name of the parameters of the subprogram
@@--  @_PARAM_TY_@ Fully qualified name of the type of the parameters of the
@@--               subprogram.
@@--  @_GLOBAL_NAME_@ Fully qualified names of the global inputs of the
@@--                  subprogram.
@@--  @_GLOBAL_TY_@ Fully qualified names of the global inputs types
@@--  @_GLOBAL_SLUG_@ Slugs (that can be used as identifiers) for the global
@@--                  inputs of the subprogram.
@@--  @_INPUT_FN_@ Name of the JSON input function for the parameters of the
@@--               subprogram.
@@--  @_OUTPUT_FN_@ Name of the binary output function name for the parameter
@@--                of the subprogram.
@@--  @_PARAM_JSON_TO_BIN_FN_@ Name of the JSON to Bin conversion subprogram
@@--                           for the parameter.
@@--  @_GLOBAL_INPUT_FN_@ Name of the JSON input function for the global inputs
@@--                      of the subprogram.
@@--  @_GLOBAL_OUTPUT_FN_@ Name of the binary output function name for the
@@--                       global inputs of the subprogram.
@@--  @_PARAM_JSON_TO_BIN_FN_@ Name of the JSON to Bin conversion subprogram
@@--                           for the global inputs of the subprogram.
@@--  @_NUM_TESTS_@ Number of tests to be generated for this subprogram (upper
@@--                bound for enumerative strategies)
@@--  @_ENUM_STRAT_@ Whether the strategy to be used is the default enum one, or
@@--                 the default one,
@@--  @_TC_FORMAT_@ Format in which the test cases should be dumped, either
@@--                BIN or JSON.
@@--  @_TC_NAME_@ Filename for the binary test case files.
@@--  @_TC_DIR_@ Directory for the binary test case files.
@@INCLUDE@@ json_templates/util.tmplt

@@IF@@ @_TC_FORMAT_@ = JSON
   --  Test case generation for @_SUBP_NAME_@ (dumping to a JSON Value)

   procedure Gen_@_SUBP_NAME_@_@_SUBP_UID_@
     (Unit_Tests : in out TGen.JSON.Test_Cases.JSON_Test_Cases)
   is
      use type TGen.JSON.JSON_Value;
      Subp  : TGen.Types.Typ_Access renames @_FN_TYP_REF_@;
@@IF@@ @_ENUM_STRAT_@
      Strat : TGen.Strategies.Strategy_Type'Class := Subp.all.Default_Enum_Strategy;
@@ELSE@@
      Strat : TGen.Strategies.Strategy_Type'Class := Subp.all.Default_Strategy;
@@END_IF@@

      Subp_Entry : TGen.JSON.Test_Cases.Subprogram_Test_Case;

      Num_Tests : Natural := 0;
   begin
      TGen.Random.Reset;
      if not TGen.JSON.Test_Cases.Has_Subprogram (Unit_Tests, "@_SUBP_UID_@") then
         TGen.JSON.Test_Cases.Add_Subprogram_To_JSON_File
           (Unit_Tests,
            "@_SUBP_UID_@",
            TGen.JSON.Test_Cases.Create_Subprogram_Test_Case
              ("@_SUBP_FQN_@", "@_SUBP_RETURN_TY_@"));
      end if;
      Subp_Entry := TGen.JSON.Test_Cases.Get_Subprogram (Unit_Tests, "@_SUBP_UID_@");
      Strat.Init;
      while Strat.Has_Next
           and then (Num_Tests < @_NUM_TESTS_@ or else @_NUM_TESTS_@ = 0)
      loop
         Generate_One : declare
            Values      : constant TGen.JSON.JSON_Value :=
              Subp.all.Encode (Strat.Generate (TGen.Strategies.Disc_Value_Maps.Empty_Map));
            Param_Vec   : TGen.JSON.Test_Cases.Subprogram_Parameter_Vector :=
              TGen.JSON.Test_Cases.Create_Subprogram_Parameters;
            Globals_Obj : TGen.JSON.JSON_Value :=
              (if Values.Has_Field ("global_values")
               then Values.Get ("global_values")
               else TGen.JSON.JSON_Null);
            Globals_Vec : TGen.JSON.Test_Cases.Subprogram_Parameter_Vector :=
              TGen.JSON.Test_Cases.Create_Subprogram_Parameters;
         begin
@@TABLE@@
            TGen.JSON.Test_Cases.Append_Parameter
              (Param_Vec,
               TGen.JSON.Test_Cases.Create_Parameter
                 (Name      => "@_PARAM_NAME_@",
                  Type_Name => "@_PARAM_TY_@",
                  Value     => Values.Get("param_values").Get("@_PARAM_NAME_@")));
@@END_TABLE@@
@@TABLE@@
            TGen.JSON.Test_Cases.Append_Parameter
              (Globals_Vec,
               TGen.JSON.Test_Cases.Create_Parameter
                 (Name      => "@_GLOBAL_NAME_@",
                  Type_Name => "@_GLOBAL_TY_@",
                  Value     => Values.Get("global_values").Get("@_GLOBAL_NAME_@")));
@@END_TABLE@@
            TGen.JSON.Test_Cases.Add_Test
              (Subp_Entry,
               TGen.JSON.Test_Cases.Create_Subprogram_Test
                 (Param_Values => Param_Vec,
                  Origin       => "TGen",
                  Globals      => Globals_Vec));
            Num_Tests := Num_Tests + 1;
         end Generate_One;
      end loop;
   end Gen_@_SUBP_NAME_@_@_SUBP_UID_@;

@@ELSE@@
   --  Test case generation for @_SUBP_NAME_@ (dumping to a binary file)

   procedure Gen_@_SUBP_NAME_@_@_SUBP_UID_@
   is
      Subp  : TGen.Types.Typ_Access renames @_FN_TYP_REF_@;
@@IF@@ @_ENUM_STRAT_@
      Strat : TGen.Strategies.Strategy_Type'Class := Subp.all.Default_Enum_Strategy;
@@ELSE@@
      Strat : TGen.Strategies.Strategy_Type'Class := Subp.all.Default_Strategy;
@@END_IF@@
      File  : Ada.Streams.Stream_IO.File_Type;
      Stream : Ada.Streams.Stream_IO.Stream_Access;
      Output_Dir : constant String :=
         Ada.Environment_Variables.Value
            ("TGEN_GENERATION_OUTPUT_DIR", "@_TC_DIR_@");
      Num_Tests : Natural := 0;
   begin
      TGen.Random.Reset;
      Strat.Init;
      while Strat.Has_Next
           and then (Num_Tests < @_NUM_TESTS_@ or else @_NUM_TESTS_@ = 0)
      loop
         Generate_One : declare
            Values      : constant TGen.JSON.JSON_Value :=
              Subp.all.Encode
                (Strat.Generate (TGen.Strategies.Disc_Value_Maps.Empty_Map));
         begin
            Ada.Streams.Stream_IO.Create
              (File,
               Name =>
                 Output_Dir & GNAT.OS_Lib.Directory_Separator & "@_TC_NAME_@-" & Ada.Strings.Fixed.Trim
                   (Positive'Image (Num_Tests), Ada.Strings.Both));
            Stream := Ada.Streams.Stream_IO.Stream (File);
@@TABLE'ALIGN_ON(":")@@
            @_PARAM_JSON_TO_BIN_FN_@ (Stream, Values.Get ("param_values").Get ("@_PARAM_NAME_@"));
@@END_TABLE@@
         if Values.Has_Field ("global_values")
           and then Values.Get ("global_values").Kind not in TGen.JSON.JSON_Null_Type
         then
            null;
@@TABLE@@
            @_GLOBAL_JSON_TO_BIN_FN_@ (Stream, Values.Get ("global_values").Get ("@_GLOBAL_NAME_@"));
@@END_TABLE@@
         end if;
            Ada.Streams.Stream_IO.Close (File);
            Num_Tests := Num_Tests + 1;
         end Generate_One;
      end loop;
   end Gen_@_SUBP_NAME_@_@_SUBP_UID_@;
@@END_IF@@

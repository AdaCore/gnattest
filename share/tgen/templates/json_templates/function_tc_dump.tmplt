@@--  Template to generate functions to dump a testcase in JSON
@@--  @_GLOBAL_PREFIX_@ Prefix used to prefix all local entities to the unit.
@@--  @_FOR_SPEC_@ Boolean determining is the template is parsed as a
@@--               specification or as a body.
@@--  @_PROC_NAME_@ Name of the subprogram for which we want to dump a TC.
@@--  @_PROC_FQN_@  Fully Qualified Name of the subprogram for which we
@@--                want to dump a TC.
@@--  @_PROC_RETURN_TY_@ name of the return type of the subprogram
@@--  @_PARAM_NAME_@ Simple names of the parameters of the subprogram.
@@--  @_PARAM_TY_@ Ada names of the types of the parameters of the subprogram
@@--  @_LAL_PARAM_TY_@ Same as above, but with the optional "Standard" prefix
@@--                    for predefined types.
@@--  @_PARAM_TY_OUTPUT_FN_@ Slug names of the parameter types.
@@--  @_GLOBAL_NAME_@ Simple names of the global inputs of the subprogram.
@@--  @_GLOBAL_SLUG_@ Slug names of the global inputs.
@@--  @_GLOBAL_TY_@ Ada names of the types of the global inputs.
@@--  @_LAL_GLOBAL_TY_@ Same as above, but with the optional "Standard" prefix
@@--                     for predefined types.
@@--  @_GLOBAL_TY_OUTPUT_FN_@ Slug names of the global inputs type.
@@--  @_PROC_UID_@ Subprogram_UID
@@--
@@INCLUDE@@ util.tmplt

   --  Test Case JSON dumper for @_PROC_NAME_@ from Ada values

   procedure @_PROC_NAME_@_Dump_TC (
@@TABLE'ALIGN_ON(":")@@
     @_GLOBAL_PREFIX_@_@_PARAM_NAME_@ : TGen.TGen_Std.@_PARAM_TY_@;
@@END_TABLE@@
@@TABLE'ALIGN_ON(":")@@
      @_GLOBAL_PREFIX_@_@_GLOBAL_SLUG_@ : TGen.TGen_Std.@_GLOBAL_TY_@ := @_GLOBAL_NAME_@;
@@END_TABLE@@
      TGen_Unit_JSON : in out TGen.JSON.JSON_Value;
@@IF@@ @_FOR_SPEC_@
      TGen_Test_Origin : String := "") with
      Pre => TGen_Unit_JSON.Kind in TGen.JSON.JSON_Object_Type;
   --  Serialize the test-case represented by the first parameters that
   --  correspond to those of @_PROC_NAME_@ (not necessarily in the same
   --  order), in JSON_Unit, which should be either an empty JSON_Object, or
   --  a JSON object containing already serialized test cases, either through
   --  similar <SUbp_Name>_Dump_TC procedures, or generated by GNATtest.
   --
   --  Origin is used to record which tool created the test-case being
   --  serialized.
@@ELSE@@
      TGen_Test_Origin : String := "")
   is
      package TJTC renames TGen.JSON.Test_Cases;
      Unit_TC                  : TJTC.JSON_Test_Cases;
      Subp_Entry               : TJTC.Subprogram_Test_Case;
      New_Test_Vec_Param_Vals  : TJTC.Subprogram_Parameter_Vector :=
        TJTC.Create_Subprogram_Parameters;
      New_Test_Vec_Global_Vals : TJTC.Subprogram_Parameter_Vector :=
        TJTC.Create_Subprogram_Parameters;
   begin
      TJTC.Bind_JSON (Unit_TC, TGen_Unit_JSON);
      if TJTC.Has_Subprogram (Unit_TC, "@_PROC_UID_@") then
         Subp_Entry := TJTC.Get_Subprogram (Unit_TC, "@_PROC_UID_@");
      else
         Subp_Entry := TJTC.Create_Subprogram_Test_Case
           (Qualified_Name   => "@_PROC_FQN_@",
            Return_Type_Name => "@_PROC_RETURN_TY_@");
         TJTC.Add_Subprogram_To_JSON_File
           (Unit_TC,
            "@_PROC_UID_@",
            Subp_Entry);
      end if;
@@TABLE@@
      TJTC.Append_Parameter
        (New_Test_Vec_Param_Vals,
         TJTC.Create_Parameter
           (Name      => "@_PARAM_NAME_@",
            Type_Name => "@_LAL_PARAM_TY_@",
            Mode      => "@_PARAM_MODE_@",
            Value     => @_PARAM_TY_OUTPUT_FN_@ (@_GLOBAL_PREFIX_@_@_PARAM_NAME_@)));
@@END_TABLE@@
@@TABLE@@
      TJTC.Append_Parameter
        (New_Test_Vec_Global_Vals,
         TJTC.Create_Parameter
           (Name      => "@_GLOBAL_NAME_@",
            Type_Name => "@_LAL_GLOBAL_TY_@",
            Mode      => "in",
            Value     => @_GLOBAL_TY_OUTPUT_FN_@ (@_GLOBAL_PREFIX_@_@_GLOBAL_SLUG_@)));
@@END_TABLE@@
      TJTC.Add_Test
        (Subp_Entry,
         TJTC.Create_Subprogram_Test
           (Param_Values => New_Test_Vec_Param_Vals,
            Origin       => TGen_Test_Origin,
            Globals      => New_Test_Vec_Global_Vals));
    end @_PROC_NAME_@_Dump_TC;
@@END_IF@@

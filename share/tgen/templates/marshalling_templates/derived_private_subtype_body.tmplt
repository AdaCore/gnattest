@@--  Template for input and output marshalling functions for types deriving
@@--  from a private parent type.
@@--  @_GLOBAL_PREFIX_@ Prefix for all public TGen entities of the unit.
@@--  @_TY_PREFIX_@ Prefix for all entities of the current type.
@@--  @_TY_NAME_@ Name of the current type.
@@--  @_TY_SLUG_@ FQN of TY made compatible with an Ada identifier
@@--  @_PARENT_TY_NAME_@ FQN of the type from which @_TY_NAME_@ derives
@@--  @_PARENT_TY_NAME_SLUG_@ FQN of the parent type, compatible with an Ada identifier


   function @_PARENT_TY_NAME_SLUG_@_To_@_TY_SLUG_@ is new Ada.Unchecked_Conversion
      (@_PARENT_TY_NAME_@, @_TY_NAME_@);

   procedure @_TY_PREFIX_@_Read
      (@_GLOBAL_PREFIX_@_Stream : not null access Ada.Streams.Root_Stream_Type'Class;
       @_GLOBAL_PREFIX_@_Buffer : in out Interfaces.Unsigned_8;
       @_GLOBAL_PREFIX_@_Offset : in out TGen.Marshalling_Lib.Offset_Type;
       @_GLOBAL_PREFIX_@_V      : out TGen.TGen_Std.@_TY_NAME_@)
   is
      Value : @_PARENT_TY_NAME_@;
   begin
      @_PARENT_TY_PACKAGE_@.TGen_Support.@_GLOBAL_PREFIX_@_@_PARENT_TY_NAME_SLUG_@_Read
        (@_GLOBAL_PREFIX_@_Stream, @_GLOBAL_PREFIX_@_Buffer, @_GLOBAL_PREFIX_@_Offset, Value);
      @_GLOBAL_PREFIX_@_V := @_PARENT_TY_NAME_SLUG_@_To_@_TY_SLUG_@ (Value);
   end @_TY_PREFIX_@_Read;

   function @_TY_SLUG_@_To_@_PARENT_TY_NAME_SLUG_@ is new Ada.Unchecked_Conversion
      (@_TY_NAME_@, @_PARENT_TY_NAME_@);

   procedure @_TY_PREFIX_@_Write
      (@_GLOBAL_PREFIX_@_Stream : not null access Ada.Streams.Root_Stream_Type'Class;
       @_GLOBAL_PREFIX_@_Buffer : in out Interfaces.Unsigned_8;
       @_GLOBAL_PREFIX_@_Offset : in out TGen.Marshalling_Lib.Offset_Type;
       @_GLOBAL_PREFIX_@_V      : TGen.TGen_Std.@_TY_NAME_@)
   is
      Value : constant @_PARENT_TY_NAME_@ := @_TY_SLUG_@_To_@_PARENT_TY_NAME_SLUG_@ (@_GLOBAL_PREFIX_@_V);
   begin
      @_PARENT_TY_PACKAGE_@.TGen_Support.@_GLOBAL_PREFIX_@_@_PARENT_TY_NAME_SLUG_@_Write
        (@_GLOBAL_PREFIX_@_Stream, @_GLOBAL_PREFIX_@_Buffer, @_GLOBAL_PREFIX_@_Offset, Value);
   end @_TY_PREFIX_@_Write;
